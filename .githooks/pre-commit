#!/bin/sh
# Runs the backend + frontend test suites before every commit. Skips each
# gracefully (never blocks the commit) if its runtime isn't available right
# now — this is a safety net for a personal single-dev repo, not a hard CI
# gate.
#
# Installed via: git config core.hooksPath .githooks
# Bypass once with: git commit --no-verify

if docker compose ps --status running --services 2>/dev/null | grep -q "^backend$"; then
    echo "[pre-commit] Running backend tests..."
    if ! docker compose exec -T backend python -m pytest -q; then
        echo "[pre-commit] Backend tests FAILED — commit blocked."
        echo "[pre-commit] Fix the failure, or bypass with: git commit --no-verify"
        exit 1
    fi
    echo "[pre-commit] Backend tests passed."
else
    echo "[pre-commit] Backend container isn't running — skipping backend tests."
fi

if git diff --cached --name-only | grep -q '^frontend/'; then
    # Docker first, not local npm: this machine has node installed but not
    # on the PATH a fresh shell inherits, so the local branch silently never
    # ran and the frontend tests went unexecuted for the life of the repo.
    # The `test` stage also pins the Node version and uses linux
    # node_modules — the host's carry Windows-only binaries that cannot run
    # in a container, and its Node 20 breaks jsdom.
    if command -v docker >/dev/null 2>&1; then
        echo "[pre-commit] Running frontend tests (docker build --target test)..."
        if ! docker build --target test -t cld-frontend-test frontend; then
            echo "[pre-commit] Frontend tests FAILED — commit blocked."
            echo "[pre-commit] Fix the failure, or bypass with: git commit --no-verify"
            exit 1
        fi
        echo "[pre-commit] Frontend tests passed."
    elif [ -d frontend/node_modules ] && command -v npm >/dev/null 2>&1; then
        echo "[pre-commit] Running frontend tests (local npm)..."
        if ! (cd frontend && npm test --silent); then
            echo "[pre-commit] Frontend tests FAILED — commit blocked."
            exit 1
        fi
        echo "[pre-commit] Frontend tests passed."
    else
        echo "[pre-commit] WARNING: no docker and no npm — frontend tests NOT run."
    fi

    if command -v docker >/dev/null 2>&1; then
        echo "[pre-commit] Verifying frontend build (docker compose build frontend)..."
        if ! docker compose build frontend; then
            echo "[pre-commit] Frontend build FAILED (type-check/lint/build) — commit blocked."
            echo "[pre-commit] Fix the failure, or bypass with: git commit --no-verify"
            exit 1
        fi
        echo "[pre-commit] Frontend build passed."
    else
        echo "[pre-commit] WARNING: docker not available — frontend build/lint/type-check was NOT verified for this commit."
    fi
else
    echo "[pre-commit] No frontend/ changes staged — skipping frontend build check."
fi

exit 0
