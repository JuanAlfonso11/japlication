#!/bin/sh
# Runs the backend + frontend test suites before every commit. Skips each
# gracefully (never blocks the commit) if its runtime isn't available right
# now — this is a safety net for a personal single-dev repo, not a hard CI
# gate.
#
# Installed via: git config core.hooksPath .githooks
# Bypass once with: git commit --no-verify

# --- Secretos: nada de esto sale del disco --------------------------------
# Este repo nunca ha tenido un secreto real en su historial -- se auditaron los
# 1570 blobs de los 138 commits, uno por uno, contra cada valor del .env real.
# Esta comprobacion existe para que siga siendo verdad sin depender de que
# alguien se acuerde. Reescribir el historial despues es caro, destructivo, y
# no des-filtra nada que ya se haya subido.
#
# Dos capas. La primera, los nombres: ningun archivo que sea un .env de verdad,
# una credencial, un keystore o un backup entra al commit.
BLOCKED=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '(^|/)\.env($|\.[^e]|\.e[^x])|(^|/)backend/secrets/|(^|/)backups/|\.(jks|keystore|p12|pfx|pem)$|(^|/)backend/runtime/|keystore\.properties$|google-services\.json$|\.apk$' || true)
if [ -n "$BLOCKED" ]; then
    echo "[pre-commit] BLOQUEADO: estos archivos no se suben nunca:"
    echo "$BLOCKED" | sed 's/^/    /'
    echo "[pre-commit] Si de verdad hace falta, revisa .gitignore primero."
    exit 1
fi

# La segunda, el contenido: el valor del secreto pegado dentro de cualquier
# archivo -- un docker-compose, un script, un README, un test. Es la forma en
# que estas cosas se filtran de verdad, no subiendo el .env entero.
LEAK=$(git diff --cached -U0 --diff-filter=ACM \
    | grep -E '^\+' \
    | grep -ivE '(example|placeholder|your-key|tu-clave|pon-aqui|change-me|fake|dummy|xxx)' \
    | grep -oE 'sk-ant-[A-Za-z0-9_-]{16,}|AIza[0-9A-Za-z_-]{30,}|ghp_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' \
    || true)
if [ -n "$LEAK" ]; then
    echo "[pre-commit] BLOQUEADO: esto parece una credencial de verdad dentro de un archivo:"
    echo "$LEAK" | sed 's/^\(.\{12\}\).*/    \1.../'
    echo "[pre-commit] Sacala a .env (que esta gitignoreado) y deja un placeholder."
    exit 1
fi

# Y el .env real de esta maquina, valor por valor: es la unica comprobacion que
# detecta una clave con un formato que ningun patron generico reconoce -- una
# contrasena de aplicacion de Gmail, por ejemplo, son 16 letras sueltas.
if [ -f .env ]; then
    STAGED=$(git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' || true)
    if [ -n "$STAGED" ]; then
        while IFS= read -r line; do
            case "$line" in \#*|"") continue;; esac
            key="${line%%=*}"; val="${line#*=}"
            val="${val%\"}"; val="${val#\"}"
            # Solo valores que de verdad parecen secretos: largos y sin
            # aspecto de URL o de nombre de host, para no bloquear un commit
            # por mencionar el hostname de la tailnet, que esta documentado a
            # proposito en docs/ANDROID_APP.md.
            # Ajustes de busqueda, no secretos: LINKEDIN_LOCATION es un pais
            # ("Dominican Republic"), y bloqueaba cualquier commit que
            # nombrara ese pais -- como la lista de paises de
            # work_authorization.py.
            case "$key" in *_LOCATION|*_COUNTRY|*_QUERY|*_KEYWORDS) continue;; esac
            [ ${#val} -lt 16 ] && continue
            case "$val" in http*|*.ts.net*|*localhost*|*@*.*) continue;; esac
            if printf '%s' "$STAGED" | grep -qF -- "$val"; then
                echo "[pre-commit] BLOQUEADO: el valor de $key (de tu .env) aparece en lo que vas a commitear."
                exit 1
            fi
        done < .env
    fi
fi

if docker compose ps --status running --services 2>/dev/null | grep -q "^backend$"; then
    echo "[pre-commit] Running backend tests..."
    if ! docker compose exec -T backend python -m pytest -q; then
        echo "[pre-commit] Backend tests FAILED — commit blocked."
        echo "[pre-commit] Fix the failure, or bypass with: git commit --no-verify"
        exit 1
    fi
    echo "[pre-commit] Backend tests passed."
else
    echo "[pre-commit] Backend container isn't running — skipping backend tests."
fi

# Schema drift: db/schema.sql must produce the same database as running the
# migrations from scratch. app/scripts/migrate.py stamps a database that has
# tables but no Alembic history as "already up to date", so when the two
# disagree a freshly-created database is permanently missing whatever only
# lived in a migration — silently, and unfixable by any later migration.
# Migrations 0006 and 0007 lived outside schema.sql for weeks exactly this way.
# Only runs when the schema actually changed, because it costs ~20s.
if git diff --cached --name-only | grep -qE '^(db/schema\.sql|backend/alembic/versions/)'; then
    if docker compose ps --status running --services 2>/dev/null | grep -q "^db$"; then
        echo "[pre-commit] Checking schema drift..."
        if ! powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-schema-drift.ps1; then
            echo "[pre-commit] Schema drift detected — commit blocked."
            echo "[pre-commit] Put the change in BOTH db/schema.sql and a migration."
            exit 1
        fi
    else
        echo "[pre-commit] db container isn't running — skipping schema drift check."
    fi
fi

if git diff --cached --name-only | grep -q '^frontend/'; then
    # Docker first, not local npm: this machine has node installed but not
    # on the PATH a fresh shell inherits, so the local branch silently never
    # ran and the frontend tests went unexecuted for the life of the repo.
    # The `test` stage also pins the Node version and uses linux
    # node_modules — the host's carry Windows-only binaries that cannot run
    # in a container, and its Node 20 breaks jsdom.
    if command -v docker >/dev/null 2>&1; then
        echo "[pre-commit] Running frontend tests (docker build --target test)..."
        if ! docker build --target test -t cld-frontend-test frontend; then
            echo "[pre-commit] Frontend tests FAILED — commit blocked."
            echo "[pre-commit] Fix the failure, or bypass with: git commit --no-verify"
            exit 1
        fi
        echo "[pre-commit] Frontend tests passed."
    elif [ -d frontend/node_modules ] && command -v npm >/dev/null 2>&1; then
        echo "[pre-commit] Running frontend tests (local npm)..."
        if ! (cd frontend && npm test --silent); then
            echo "[pre-commit] Frontend tests FAILED — commit blocked."
            exit 1
        fi
        echo "[pre-commit] Frontend tests passed."
    else
        echo "[pre-commit] WARNING: no docker and no npm — frontend tests NOT run."
    fi

    if command -v docker >/dev/null 2>&1; then
        echo "[pre-commit] Verifying frontend build (docker compose build frontend)..."
        if ! docker compose build frontend; then
            echo "[pre-commit] Frontend build FAILED (type-check/lint/build) — commit blocked."
            echo "[pre-commit] Fix the failure, or bypass with: git commit --no-verify"
            exit 1
        fi
        echo "[pre-commit] Frontend build passed."
    else
        echo "[pre-commit] WARNING: docker not available — frontend build/lint/type-check was NOT verified for this commit."
    fi
else
    echo "[pre-commit] No frontend/ changes staged — skipping frontend build check."
fi

exit 0
