<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain http:// only to your Tailscale hostname (the *.ts.net domain
  Tailscale assigns via MagicDNS) — not to the public internet. This is
  intentionally narrow: Tailscale traffic is already end-to-end encrypted at
  the VPN layer, so http:// within the tailnet never touches the internet
  in the clear, but this config still blocks cleartext to any other host,
  so nothing else the WebView might load can silently downgrade to http://.
  See ../capacitor.config.ts and docs/ANDROID_APP.md.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
