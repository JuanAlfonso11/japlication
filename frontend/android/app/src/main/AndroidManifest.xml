<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified Android App Links: tapping a link to JobPilot's own
                 host (the password-reset and verification emails, any shared
                 link) opens the app directly instead of the browser. The
                 host is public since Tailscale Funnel, so Android can fetch
                 https://<host>/.well-known/assetlinks.json (served from
                 frontend/public) and match it against the APK's signing
                 certificate. If verification fails (e.g. the APK is signed
                 with a different key than the one listed there) Android
                 simply falls back to the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="jobpilot.tailb3d4c1.ts.net" />
                <data android:scheme="https" android:host="jobpilot.tailb3d4c1.ts.net" android:port="8443" />
            </intent-filter>

            <!-- Puts JobPilot in Android's share sheet. Seeing a posting in
                 Chrome or LinkedIn and saving it used to mean: copy the URL,
                 leave, open JobPilot, go to Importar, paste, submit. With
                 this it's Compartir -> JobPilot, and MainActivity forwards
                 the shared text to the import screen, which starts on its
                 own. text/plain is what every app sends for a link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app hand a downloaded APK straight to Android's package
         installer, so an update is "tap Actualizar, confirm, done" instead
         of "tap the notification, find the file in Downloads, open it,
         install". Android still gates this behind a one-time per-app
         "allow from this source" toggle the user grants themselves; this
         permission only makes JobPilot eligible to ask. It cannot install
         anything silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
