# PostgreSQL connection (async, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://jobflow:jobflow@localhost:5432/jobflow

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Optional: enables AI-powered resume adaptation / cover letters / job parsing upgrades.
# When unset, the app falls back to deterministic, fully-offline logic.
ANTHROPIC_API_KEY=

# CORS: origin of the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# Optional: live job search providers (all three are optional; the
# "himalayas" provider needs none of these and works out of the box).

# Google Jobs via SerpApi (https://serpapi.com/search?engine=google_jobs).
# Get a key at https://serpapi.com — without it, provider=google_jobs
# returns a clean 503 and the frontend hides that search tab's results.
SERPAPI_API_KEY=
SERPAPI_DEFAULT_HL=es
SERPAPI_DEFAULT_GL=us

# Upwork (OAuth2 authorization-code flow + GraphQL). Register an app at
# https://www.upwork.com/developer/apps to get a client id/secret — the
# redirect URI you register there must match UPWORK_REDIRECT_URI exactly.
# Without these, provider=upwork stays hidden behind a "not configured"
# state in the UI.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/upwork/callback
