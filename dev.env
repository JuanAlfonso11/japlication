# Entorno de DESARROLLO: corre al lado de produccion en la misma PC sin tocarla.
# Se carga DESPUES de .env y solo pisa lo que cambia; los secretos siguen en .env.
#
#   docker compose -p jobpilot-dev --env-file .env --env-file dev.env up -d --build
#
# `-p jobpilot-dev` le da contenedores y volumen de Postgres propios: la base de
# desarrollo esta vacia y borrarla (`... down -v`) no toca la de produccion.
DB_PORT=5433
BACKEND_PORT=8001
FRONTEND_PORT=3002
FRONTEND_ORIGIN=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
CORS_EXTRA_ORIGINS=
ENABLE_API_DOCS=1
# Sin correos ni pushes reales desde desarrollo.
SMTP_HOST=
FIREBASE_CREDENTIALS_PATH=
