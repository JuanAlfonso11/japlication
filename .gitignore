# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# Env
.env
.env.local

# Firebase Admin SDK service account key — full admin credential for the
# Firebase project, never committed (same treatment as .env)
backend/secrets/

# Auto-generated at container startup (SYSTEM_HEARTBEAT_SECRET) — never
# committed, same treatment as .env
backend/runtime/

# Local DB backups (scripts/backup-db.ps1) — contain real user data,
# never committed
backups/

# Watchdog activity log (scripts/watchdog.ps1) — local operational log, not
# project content
logs/

# Generated .ico for the desktop shortcut (scripts/install-desktop-shortcut.ps1)
scripts/.icon/

# The actual APK binary served by scripts/apk-server/ — rebuilt and copied
# here each native release (see docs/ANDROID_APP.md), never committed.
scripts/apk-server/*.apk

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Notas internas de desarrollo (no para usuarios)
README.dev.md

# Notas locales de agentes
.delegate/
.planning/
