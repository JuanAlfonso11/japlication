# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://jobflow:jobflow@localhost:5432/jobflow

# --- Backend / Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
# The backend's own reachable address (same host as NEXT_PUBLIC_API_URL
# below) — the verification email link hits this first (validates the
# token), then redirects to FRONTEND_ORIGIN.
BACKEND_PUBLIC_URL=http://localhost:8000/api/v1
# Comma-separated extra origins allowed to call the API (CORS) — e.g. your
# Tailscale hostname, so the Android app / phone browser can reach it too.
# See docs/ANDROID_APP.md.
CORS_EXTRA_ORIGINS=

# --- IA opcional (mejora adaptación de CV, cover letters, evaluador de CV e
# importación de CV en PDF con Claude) ---
# Si se deja vacío, el backend usa generadores/parsers basados en reglas (funciona offline).
ANTHROPIC_API_KEY=

# --- Correo de verificación de cuenta ---
# Sin SMTP_HOST, el backend registra el link de verificación en sus logs en vez
# de enviar un correo real — sigue siendo 100% funcional para desarrollo local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@jobflow.ai
SMTP_USE_TLS=true

# --- Frontend ---
# Baked into the frontend's JS at build time — must be an address every
# client can actually reach (not "localhost" if you're also accessing this
# from a phone; see docs/ANDROID_APP.md).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
