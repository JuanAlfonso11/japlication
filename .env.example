# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://jobflow:jobflow@localhost:5432/jobflow

# --- Backend / Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000

# --- IA opcional (mejora adaptación de CV y cover letters con Claude) ---
# Si se deja vacío, el backend usa generadores basados en reglas (funciona offline).
ANTHROPIC_API_KEY=

# --- Búsqueda de empleo en vivo (opcionales — "himalayas" no necesita nada) ---
# Google Jobs vía SerpApi: https://serpapi.com/search?engine=google_jobs
SERPAPI_API_KEY=
# Upwork: https://www.upwork.com/developer/apps (OAuth2 — el redirect URI
# registrado ahí debe coincidir exactamente con UPWORK_REDIRECT_URI)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/upwork/callback

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
