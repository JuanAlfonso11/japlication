# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://jobflow:jobflow@localhost:5432/jobflow

# --- Backend / Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Access token stays short-lived; "stay logged in" comes from the refresh
# token instead (revocable, stored hashed) — see docs/API_CONTRACT.md.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=90
FRONTEND_ORIGIN=http://localhost:3000
# The backend's own reachable address (same host as NEXT_PUBLIC_API_URL
# below) — the verification email link hits this first (validates the
# token), then redirects to FRONTEND_ORIGIN.
BACKEND_PUBLIC_URL=http://localhost:8000/api/v1
# Comma-separated extra origins allowed to call the API (CORS) — e.g. your
# Tailscale hostname, so the Android app / phone browser can reach it too.
# See docs/ANDROID_APP.md.
CORS_EXTRA_ORIGINS=

# --- IA opcional (mejora adaptación de CV, cover letters, evaluador de CV e
# importación de CV en PDF con Claude) ---
# Si se deja vacío, el backend usa generadores/parsers basados en reglas (funciona offline).
ANTHROPIC_API_KEY=

# --- Correo de verificación de cuenta ---
# Sin SMTP_HOST, el backend registra el link de verificación en sus logs en vez
# de enviar un correo real — sigue siendo 100% funcional para desarrollo local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@jobflow.ai
SMTP_USE_TLS=true

# --- Búsqueda de empleo: fuentes con registro (opcionales) ---
# Sin estas claves, esas 3 fuentes simplemente se saltan (mismo patrón que
# SMTP/Claude/Firebase) — las 8 fuentes gratuitas sin registro siguen
# funcionando igual. Ver docs/PUBLIC_APIS_RESEARCH.md para cómo obtenerlas.
# Adzuna: registro instantáneo en https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJobs: registro instantáneo en https://developer.usajobs.gov/
# USAJOBS_USER_AGENT es el correo con el que te registraste.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# France Travail: registro instantáneo en https://francetravail.io/
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# SerpApi (Google Jobs — incluye LinkedIn/Indeed/Glassdoor/ZipRecruiter vía
# el índice público de Google for Jobs). Registro instantáneo, 250
# búsquedas/mes gratis: https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# --- Notificaciones push (Firebase Cloud Messaging) ---
# Sin esto, el backend simplemente no manda pushes (mismo patrón que SMTP/
# Claude). Pon el service account JSON de Firebase en backend/secrets/
# (gitignored) y apunta aquí a su ruta *dentro del contenedor*
# (docker-compose.yml monta ./backend/secrets en /app/secrets).
FIREBASE_CREDENTIALS_PATH=

# --- Frontend ---
# Baked into the frontend's JS at build time — must be an address every
# client can actually reach (not "localhost" if you're also accessing this
# from a phone; see docs/ANDROID_APP.md).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
