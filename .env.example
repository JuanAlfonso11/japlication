# --- Base de datos ---
# La contrasena de Postgres. docker-compose la exige (no hay valor por
# defecto): un secreto que se sustituye solo en silencio es un secreto que
# nadie pone nunca. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=pon-aqui-una-contrasena-larga-y-aleatoria
DATABASE_URL=postgresql+asyncpg://jobflow:la-misma-de-arriba@localhost:5432/jobflow

# --- Backend / Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Access token stays short-lived; "stay logged in" comes from the refresh
# token instead (revocable, stored hashed) — see docs/API_CONTRACT.md.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=90
FRONTEND_ORIGIN=http://localhost:3000
# The backend's own reachable address (same host as NEXT_PUBLIC_API_URL
# below) — the verification email link hits this first (validates the
# token), then redirects to FRONTEND_ORIGIN.
BACKEND_PUBLIC_URL=http://localhost:8000/api/v1
# Comma-separated extra origins allowed to call the API (CORS) — e.g. your
# Tailscale hostname, so the Android app / phone browser can reach it too.
# See docs/ANDROID_APP.md.
CORS_EXTRA_ORIGINS=

# --- IA opcional (mejora adaptación de CV, cover letters, evaluador de CV e
# importación de CV en PDF con Claude) ---
# Si se deja vacío, el backend usa generadores/parsers basados en reglas (funciona offline).
# Solo si la clave NO esta atada a un workspace: sin este header la API
# responde 400 y todas las funciones de IA caen a su version sin IA en silencio.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
# Topes diarios de llamadas a la IA, POR USUARIO (se renuevan a medianoche UTC).
# CALL: lo que el usuario pide (importar/mejorar CV, CV adaptado, carta, entrevista).
# SCORING: lo automatico (match de cada vacante, resumen de la evaluacion del CV).
ANTHROPIC_DAILY_CALL_BUDGET=100
ANTHROPIC_DAILY_SCORING_BUDGET=300
# IA local con Ollama para repartir la carga con Claude (vacio = solo Claude).
# OLLAMA_ROUTE=scoring: Ollama hace lo automatico y es respaldo de lo demas.
# OLLAMA_ROUTE=all: Ollama va primero en todo; Claude queda de respaldo.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_ROUTE=scoring
OLLAMA_TIMEOUT_SECONDS=300

# --- Correo de verificación de cuenta ---
# Sin SMTP_HOST, el backend registra el link de verificación en sus logs en vez
# de enviar un correo real — sigue siendo 100% funcional para desarrollo local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@jobflow.ai
SMTP_USE_TLS=true

# --- Búsqueda de empleo: fuentes con registro (opcionales) ---
# Sin estas claves, esas 3 fuentes simplemente se saltan (mismo patrón que
# SMTP/Claude/Firebase) — las 8 fuentes gratuitas sin registro siguen
# funcionando igual. Ver docs/PUBLIC_APIS_RESEARCH.md para cómo obtenerlas.
# Adzuna: registro instantáneo en https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJobs: registro instantáneo en https://developer.usajobs.gov/
# USAJOBS_USER_AGENT es el correo con el que te registraste.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# SerpApi (Google Jobs — incluye LinkedIn/Indeed/Glassdoor/ZipRecruiter vía
# el índice público de Google for Jobs). Registro instantáneo, 250
# búsquedas/mes gratis: https://serpapi.com/users/sign_up
SERPAPI_API_KEY=
# Web3.career: token gratis en https://web3.career/web3-jobs-api
WEB3CAREER_TOKEN=

# LinkedIn: sin clave ni cuenta (sus páginas públicas de empleo). Ubicación por
# defecto cuando Discover no manda una (para remotos, decide cuáles te aplican).
LINKEDIN_LOCATION=Worldwide

# --- Actualizacion de la app Android (banner "hay una actualizacion") ---
# Vacio = sin actualizacion rastreada, el banner simplemente no aparece.
# Ver scripts/apk-server/ y docs/ANDROID_APP.md.
ANDROID_LATEST_VERSION_CODE=
ANDROID_LATEST_VERSION_NAME=
ANDROID_UPDATE_APK_URL=
ANDROID_UPDATE_NOTES=

# --- Notificaciones push (Firebase Cloud Messaging) ---
# Sin esto, el backend simplemente no manda pushes (mismo patrón que SMTP/
# Claude). Pon el service account JSON de Firebase en backend/secrets/
# (gitignored) y apunta aquí a su ruta *dentro del contenedor*
# (docker-compose.yml monta ./backend/secrets en /app/secrets).
FIREBASE_CREDENTIALS_PATH=

# --- Registro de cuentas ---
# 1 = cualquiera que instale el APK se crea su cuenta. 0 = el registro se
# cierra solo en cuanto existe la primera cuenta.
ALLOW_EXTRA_REGISTRATIONS=1
# 1 = expone /docs y /openapi.json (solo para desarrollo; la app es publica).
ENABLE_API_DOCS=0

# --- Frontend ---
# Baked into the frontend's JS at build time — must be an address every
# client can actually reach (not "localhost" if you're also accessing this
# from a phone; see docs/ANDROID_APP.md).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# JobPilot Admin (dashboard de tokens). Sin ADMIN_INGEST_KEY no se reporta nada.
ADMIN_URL=http://host.docker.internal:3030
ADMIN_INGEST_KEY=
